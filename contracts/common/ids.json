{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/contracts/common/ids.json",
  "title": "Ids",
  "description": "Identifier types (CONTRACTS §3.2). Only the ids the seed schemas use (Q-CT-6); the rest land with their first user.",
  "$defs": {
    "CommanderId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "description": "UUIDv7, canonical lowercase (IDENTITY §1). Not a platform id."},
    "CampaignId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "description": "UUIDv7, canonical lowercase."},
    "EntityId": {"type": "integer", "minimum": 1, "description": "Sequential per campaign, never reused (SC-4)."},
    "NodeId": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 32, "description": "Stable slug from the theater file."},
    "SectorId": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 32, "description": "Named map region from the theater file (OVERLAY AN-1)."},
    "Tick": {"type": "integer", "minimum": 0, "description": "10 Hz game time (SC-2)."},
    "CommandSeq": {"type": "integer", "minimum": 1, "description": "Arrival order assigned by the runtime inbox; carried as arrival_seq."},
    "Callsign": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,11}$", "description": "Generated WORD-NN or approved custom (IDENTITY §2-3)."},
    "WeaponId": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,31}$", "description": "Weapon profile id from content/weapons.yaml (CONFIG-AND-CONTENT §7.2)."},
    "PlatformMessageId": {"type": "string", "minLength": 1, "maxLength": 128, "description": "Platform-provided; dedupe only."}
  }
}

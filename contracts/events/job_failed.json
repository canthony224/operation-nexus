{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/contracts/events/job_failed.json",
  "title": "JobFailed",
  "description": "The job can no longer be done (TB-1), e.g. the node it served was lost. Its claims are released; jobs that depend on it fail too (TB-8). Stored durably (Q-ALN-16).",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "tick", "event_seq", "campaign_id", "job_id"],
  "properties": {
    "kind": {"const": "JobFailed"},
    "tick": {"$ref": "../common/ids.json#/$defs/Tick"},
    "event_seq": {"type": "integer", "minimum": 1, "description": "Campaign-wide, monotonic, deterministic (SC-14)."},
    "campaign_id": {"$ref": "../common/ids.json#/$defs/CampaignId"},
    "job_id": {"$ref": "../common/ids.json#/$defs/TaskingJobId"}
  }
}

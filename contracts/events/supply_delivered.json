{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/contracts/events/supply_delivered.json",
  "title": "SupplyDelivered",
  "description": "A truck's unloading stop at a node ended (CONTRACTS §6; NX-123): its cargo ran out, the node reached its maximum, or it drove off. One event per stop, amount = the whole stock units delivered at that node during the stop; none when 0 were delivered. Public view: none for coalition, ENEMY deliveries are dropped.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "tick", "event_seq", "campaign_id", "node_id", "amount", "carrier_id", "commander_id"],
  "properties": {
    "kind": {"const": "SupplyDelivered"},
    "tick": {"$ref": "../common/ids.json#/$defs/Tick"},
    "event_seq": {"type": "integer", "minimum": 1, "description": "Campaign-wide, monotonic, deterministic (SC-14)."},
    "campaign_id": {"$ref": "../common/ids.json#/$defs/CampaignId"},
    "node_id": {"$ref": "../common/ids.json#/$defs/NodeId"},
    "amount": {"type": "integer", "minimum": 1, "x-unit": "stock units"},
    "carrier_id": {"$ref": "../common/ids.json#/$defs/EntityId"},
    "commander_id": {"anyOf": [{"$ref": "../common/ids.json#/$defs/CommanderId"}, {"type": "null"}]}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/contracts/events/campaign_clock_paused.json",
  "title": "CampaignClockPaused",
  "description": "The campaign clock stopped (CONTRACTS 6; STATE-MACHINES 4.4; NX-126). The staff note is not in the event. Public view: sub_reason omitted (Q-ALN-39).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "tick",
    "event_seq",
    "campaign_id",
    "reason",
    "sub_reason"
  ],
  "properties": {
    "kind": {
      "const": "CampaignClockPaused"
    },
    "tick": {
      "$ref": "../common/ids.json#/$defs/Tick"
    },
    "event_seq": {
      "type": "integer",
      "minimum": 1,
      "description": "Campaign-wide, monotonic, deterministic (SC-14)."
    },
    "campaign_id": {
      "$ref": "../common/ids.json#/$defs/CampaignId"
    },
    "reason": {
      "$ref": "../common/enums.json#/$defs/PauseReasonCategory"
    },
    "sub_reason": {
      "anyOf": [
        {
          "$ref": "../common/enums.json#/$defs/StaffPauseSubReason"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}

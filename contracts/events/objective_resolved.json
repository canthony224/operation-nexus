{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/contracts/events/objective_resolved.json",
  "title": "ObjectiveResolved",
  "description": "A timed objective was completed or expired (CONTRACTS 6; STATE-MACHINES 4.5; NX-126). participant_commander_ids: for a capture, the NodeCaptured participants; for a hold, the coalition commanders with units within capture.radius_m of the node at the deadline; ascending, no duplicates (producer); empty on EXPIRED.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "tick",
    "event_seq",
    "campaign_id",
    "objective_id",
    "outcome",
    "participant_commander_ids"
  ],
  "properties": {
    "kind": {
      "const": "ObjectiveResolved"
    },
    "tick": {
      "$ref": "../common/ids.json#/$defs/Tick"
    },
    "event_seq": {
      "type": "integer",
      "minimum": 1,
      "description": "Campaign-wide, monotonic, deterministic (SC-14)."
    },
    "campaign_id": {
      "$ref": "../common/ids.json#/$defs/CampaignId"
    },
    "objective_id": {
      "$ref": "../common/ids.json#/$defs/ObjectiveId"
    },
    "outcome": {
      "$ref": "../common/enums.json#/$defs/ObjectiveOutcome"
    },
    "participant_commander_ids": {
      "type": "array",
      "items": {
        "$ref": "../common/ids.json#/$defs/CommanderId"
      }
    }
  }
}

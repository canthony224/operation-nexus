{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/contracts/events/job_done.json",
  "title": "JobDone",
  "description": "The job succeeded (TB-1, TB-10). participants are the claimants that had made progress; auto is true for a commander's unit that was AI-run (AUTO) at completion: those are AUTO assists for recaps only and never XP, merit or leaderboards (Q-ALN-30). Stored durably (Q-ALN-16).",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "tick", "event_seq", "campaign_id", "job_id", "participants"],
  "properties": {
    "kind": {"const": "JobDone"},
    "tick": {"$ref": "../common/ids.json#/$defs/Tick"},
    "event_seq": {"type": "integer", "minimum": 1, "description": "Campaign-wide, monotonic, deterministic (SC-14)."},
    "campaign_id": {"$ref": "../common/ids.json#/$defs/CampaignId"},
    "job_id": {"$ref": "../common/ids.json#/$defs/TaskingJobId"},
    "participants": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["entity_id", "commander_id", "auto"], "properties": {"entity_id": {"$ref": "../common/ids.json#/$defs/EntityId"}, "commander_id": {"anyOf": [{"$ref": "../common/ids.json#/$defs/CommanderId"}, {"type": "null"}]}, "auto": {"type": "boolean"}}}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/contracts/events/objective_announced.json",
  "title": "ObjectiveAnnounced",
  "description": "A timed objective was announced (CONTRACTS 6; STATE-MACHINES 4.5; NX-126). deadline_tick is on the campaign clock (running ticks, the Hud's campaign_clock.elapsed_ticks), not the tick counter: a pause delays the real tick, so the deadline is not a Tick.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "tick",
    "event_seq",
    "campaign_id",
    "objective_id",
    "node_id",
    "deadline_tick"
  ],
  "properties": {
    "kind": {
      "const": "ObjectiveAnnounced"
    },
    "tick": {
      "$ref": "../common/ids.json#/$defs/Tick"
    },
    "event_seq": {
      "type": "integer",
      "minimum": 1,
      "description": "Campaign-wide, monotonic, deterministic (SC-14)."
    },
    "campaign_id": {
      "$ref": "../common/ids.json#/$defs/CampaignId"
    },
    "objective_id": {
      "$ref": "../common/ids.json#/$defs/ObjectiveId"
    },
    "node_id": {
      "$ref": "../common/ids.json#/$defs/NodeId"
    },
    "deadline_tick": {
      "type": "integer",
      "minimum": 1,
      "x-unit": "campaign-clock ticks"
    }
  }
}

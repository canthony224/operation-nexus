{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/contracts/events/job_expired.json",
  "title": "JobExpired",
  "description": "The job ended without success or failure (TB-1): unclaimed past its expiry, its condition passed unclaimed, or its objective ended. Stored durably (Q-ALN-16).",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "tick", "event_seq", "campaign_id", "job_id"],
  "properties": {
    "kind": {"const": "JobExpired"},
    "tick": {"$ref": "../common/ids.json#/$defs/Tick"},
    "event_seq": {"type": "integer", "minimum": 1, "description": "Campaign-wide, monotonic, deterministic (SC-14)."},
    "campaign_id": {"$ref": "../common/ids.json#/$defs/CampaignId"},
    "job_id": {"$ref": "../common/ids.json#/$defs/TaskingJobId"}
  }
}

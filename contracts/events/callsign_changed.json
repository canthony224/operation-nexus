{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/contracts/events/callsign_changed.json",
  "title": "CallsignChanged",
  "description": "A commander's callsign was set by SYS_SET_CALLSIGN (CONTRACTS \u00a76). Broadcast-only, already approved. TOMBSTONE renders as REDACTED- plus the tag after X- (Q-DM-2, Q-ALN-29).",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "tick", "event_seq", "campaign_id", "commander_id", "callsign", "callsign_kind"],
  "properties": {
    "kind": {"const": "CallsignChanged"},
    "tick": {"$ref": "../common/ids.json#/$defs/Tick"},
    "event_seq": {"type": "integer", "minimum": 1, "description": "Campaign-wide, monotonic, deterministic (SC-14)."},
    "campaign_id": {"$ref": "../common/ids.json#/$defs/CampaignId"},
    "commander_id": {"$ref": "../common/ids.json#/$defs/CommanderId"},
    "callsign": {"$ref": "../common/ids.json#/$defs/Callsign"},
    "callsign_kind": {"$ref": "../common/enums.json#/$defs/CallsignKind"}
  }
}

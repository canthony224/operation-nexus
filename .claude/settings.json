{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(gh pr merge --admin*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(git push * develop)",
      "Bash(git push * main)",
      "Bash(git push *:develop)",
      "Bash(git push *:main)",
      "Bash(gh api -X PUT *rulesets*)",
      "Bash(gh api * -X PUT *rulesets*)",
      "Bash(gh api -X PUT *protection*)",
      "Bash(gh api * -X PUT *protection*)",
      "Bash(gh api -X PATCH *rulesets*)",
      "Bash(gh api * -X PATCH *rulesets*)",
      "Bash(gh api -X PATCH *protection*)",
      "Bash(gh api * -X PATCH *protection*)",
      "Bash(gh api -X POST *rulesets*)",
      "Bash(gh api * -X POST *rulesets*)",
      "Bash(gh api -X POST *protection*)",
      "Bash(gh api * -X POST *protection*)",
      "Bash(gh api -X DELETE *rulesets*)",
      "Bash(gh api * -X DELETE *rulesets*)",
      "Bash(gh api -X DELETE *protection*)",
      "Bash(gh api * -X DELETE *protection*)",
      "Bash(gh api --method PUT *rulesets*)",
      "Bash(gh api * --method PUT *rulesets*)",
      "Bash(gh api --method PUT *protection*)",
      "Bash(gh api * --method PUT *protection*)",
      "Bash(gh api --method PATCH *rulesets*)",
      "Bash(gh api * --method PATCH *rulesets*)",
      "Bash(gh api --method PATCH *protection*)",
      "Bash(gh api * --method PATCH *protection*)",
      "Bash(gh api --method POST *rulesets*)",
      "Bash(gh api * --method POST *rulesets*)",
      "Bash(gh api --method POST *protection*)",
      "Bash(gh api * --method POST *protection*)",
      "Bash(gh api --method DELETE *rulesets*)",
      "Bash(gh api * --method DELETE *rulesets*)",
      "Bash(gh api --method DELETE *protection*)",
      "Bash(gh api * --method DELETE *protection*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail",
        "ref": "v5.3.2"
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  }
}
